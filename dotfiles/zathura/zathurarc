# =====================================
# Zathura Configuration
# =====================================

# ---------- General ----------
set selection-clipboard clipboard
set database sqlite

# ---------- Display ----------
set adjust-open best-fit
set page-padding 4
set zoom-step 10

# ---------- Scrolling ----------
set smooth-scroll true
set scroll-page-aware true

# ---------- UI ----------
set guioptions s
set statusbar-home-tilde true
set window-title-basename true
set font "JetBrainsMono Nerd Font 11"

# ---------- Rendering ----------
set render-loading true

# ---------- Colors ----------
set recolor false

# Uncomment for night reading
# set recolor true
# set recolor-keephue true

# ---------- Navigation ----------
map <Left> navigate previous
map <Right> navigate next

map <Up> scroll up
map <Down> scroll down

# ---------- Zoom ----------
map = zoom in
map - zoom out

# Fit page
map z adjust_window best-fit

# Fit width
map Z adjust_window width

# ---------- Layout ----------
map s toggle_single_page_mode
map d toggle_page_mode

# ---------- Rotate ----------
map r rotate rotate-cw
map R rotate rotate-ccw

# ---------- Reload ----------
map <C-r> reload

# ---------- Fullscreen ----------
map F toggle_fullscreen

# ---------- Presentation ----------
map p toggle_presentation

# ---------- Copy ----------
map y yank

# ---------- Links ----------
# Easier than pressing 'f'
map o follow

# Display URL without opening it
map O display_link

# ---------- Search ----------
map / search forward
map n search forward
map N search backward
