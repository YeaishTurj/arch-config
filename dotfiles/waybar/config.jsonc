{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,


  "modules-left": [
  "hyprland/workspaces"
],


"hyprland/workspaces": {
  "format": "{name}",
  "sort-by-number": true,
  "disable-scroll": true,
  "all-outputs": false,
},

  "modules-center": [
    "hyprland/window"
  ],

  "modules-right": [
    "custom/notification",
    "tray",
    "custom/brightness",
    "pulseaudio",
    "battery",
    "clock",
    "custom/power"
  ],

  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },

  "custom/notification": {
    "format": "",
    "tooltip": false,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "󰦧",
      "car": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "tooltip": false,
    "on-click": "pwvucontrol"
  },

  "custom/brightness": {
    "exec": "brightnessctl -m | cut -d',' -f4",
    "interval": 5,
    "format": "󰃠 {}",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": false
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "ADP0",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": " {capacity}%",
    "format-full": " 100%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false,
    "interval": 30
  },

"clock": {
  "format": "󰃰 {:%a %d %b  %I:%M %p}",
  "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
  "interval": 60,
  "on-click": "gsimplecal",
  "on-click-right": "gsimplecal"
},

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "wlogout --buttons-per-row 3 --column-spacing 24 --row-spacing 24",
    "on-click-right": "loginctl lock-session"
  }
}
